{
  "name": "pha-process-optimizer",
  "version": "1.0.0",
  "description": "PHA Process Optimizer & Convertor - Static HTML/JavaScript Application",
  "scripts": {
    "build": "node build.js",
    "start": "echo 'This is a static site. Open index.html in a browser.' && exit 0",
    "test:myai": "node tests/myai-regression.mjs",
    "test:process": "node --test tests/process-evidence.test.cjs tests/troubleshooting.test.cjs",
    "check:kb": "node scripts/sync-troubleshooting.cjs --check",
    "test:ui": "node tests/process-ui-review.mjs",
    "test:motion": "node tests/injection-motion.mjs",
    "test:equipment": "node tests/all-equipment-motion.mjs",
    "test:kinematics": "node --test tests/equipment-kinematics.test.cjs",
    "test:study": "node tests/equipment-study.mjs",
    "test:ts-visuals": "node --test tests/troubleshooting-visuals.test.cjs && node tests/troubleshooting-visuals.mjs",
    "check:ts-visuals": "node scripts/sync-troubleshooting-visuals.cjs --check",
    "check:vent-guide": "node scripts/sync-vent-guide.cjs --check",
    "test:vent-guide": "node --test tests/vent-guide-data.test.cjs && node tests/vent-guide-ui.mjs"
  },
  "keywords": [
    "pha",
    "process-optimizer",
    "injection-molding",
    "static-site"
  ],
  "author": "",
  "license": "ISC",
  "private": true
}
